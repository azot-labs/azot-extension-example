{
  "name": "azot-extension-example",
  "version": "1.0.0",
  "description": "Demonstrates some of the capabilities of the Azot API.",
  "keywords": [
    "video"
  ],
  "homepage": "https://azot.mov/",
  "license": "MIT",
  "author": {
    "name": "Azot",
    "url": "https://azot.mov/"
  },
  "funding": {
    "type": "individual",
    "url": "https://azot.mov/pricing"
  },
  "files": [
    "dist"
  ],
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "azt dev",
    "build": "azt build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "azot": "^5.0.0-alpha.18",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "config": {
    "icon": "https://azot.mov/assets/logo-CzwwuC-B.png",
    "title": "Azot Extension Example"
  },
  "engines": {
    "azot": ">=4.3.38"
  }
}
