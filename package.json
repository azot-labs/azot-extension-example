{
  "name": "azot-extension-example",
  "version": "1.0.0",
  "description": "Demonstrates some of the capabilities of the Azot API.",
  "keywords": [
    "video"
  ],
  "homepage": "https://azot.mov/",
  "license": "MIT",
  "author": {
    "name": "Azot",
    "url": "https://azot.mov/"
  },
  "funding": {
    "type": "individual",
    "url": "https://azot.mov/pricing"
  },
  "files": [
    "dist",
    "manifest.json",
    "icon.*"
  ],
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "azot dev",
    "build": "azot build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test -- --run",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "azot": "^5.0.0-alpha.88",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "azot": ">=5.0.0-alpha.88",
    "node": ">=24.22.1"
  }
}
